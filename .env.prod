# Production Environment Variables
# Copy this file and rename to .env.prod, then fill in your actual values

# Database
DB_PASSWORD=your_secure_database_password_here

# Frontend Environment Variables (for build time)
VITE_PUBLIC_GEMINI_API_KEY=your_gemini_api_key
VITE_API_BASE_URL=https://your-domain.com/api
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Webhook Secret (for automated deployments)
WEBHOOK_SECRET=your_webhook_secret_token
