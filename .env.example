# .env.example - Example environment variables
# In a real project, copy this to .env and fill in the secrets.
# DO NOT commit the .env file to version control.

# --- PostgreSQL Database Settings ---
# These are used by the 'db' and 'backend' services in docker-compose.yml.
POSTGRES_DB=interviewdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecretpassword

# --- Backend Datasource Configuration ---
# The backend service uses these to connect to the PostgreSQL database.
# The 'db' hostname refers to the database service in docker-compose.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/interviewdb
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=supersecretpassword

# --- GitLab CI/CD Variables ---
# These are NOT used in docker-compose directly but are required for the .gitlab-ci.yml pipeline.
# You should set these in your GitLab project's CI/CD settings.

# GitLab Registry Credentials (or Docker Hub)
# The user that can push to your container registry.
DOCKER_REGISTRY_USER=your-gitlab-username
# For GitLab, this can be a Personal Access Token or a Deploy Token.
DOCKER_REGISTRY_PASSWORD=your-gitlab-token
# The URL of your container registry.
DOCKER_REGISTRY=registry.gitlab.com

# --- Deployment Target (EC2) ---
# These are also for the GitLab CI/CD pipeline to connect to your server.
# The public IP address of your EC2 instance.
EC2_IP=12.34.56.78
# The username to connect via SSH (e.g., 'ubuntu' for Ubuntu AMIs).
SSH_USER=ubuntu
# The private key for your EC2 instance. This should be stored as a masked
# variable in GitLab CI/CD settings.
EC2_SSH_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"